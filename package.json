{
  "name": "charturbo-previs",
  "version": "0.1.0",
  "private": true,
  "description": "Previs for AI video: author a mannequin / glTF blockout as a JSON timeline doc, preview it in the browser and render it to video with the Charturbo 3D engine",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "volta": {
    "node": "22.23.4"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json",
    "previs:render": "node scripts/render.mjs",
    "previs:new": "node scripts/new.mjs",
    "previs:check": "node scripts/check.mjs",
    "previs:check-textured": "node scripts/check-textured.mjs",
    "previs:viewer": "vite --open /viewer.html"
  },
  "dependencies": {
    "charturbo": "^0.1.0",
    "draco3d": "1.5.9",
    "meshoptimizer": "1.3.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.9",
    "typescript": "^5.6.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
